{
  "name": "Radio Message Transcription",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "radio-transcription",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "radio-transcription"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "frequency",
              "value": "={{ $json.body.frequency || 100000000 }}"
            },
            {
              "name": "modulation",
              "value": "={{ $json.body.modulation || 'FM' }}"
            },
            {
              "name": "duration",
              "value": "={{ $json.body.duration || 30 }}"
            },
            {
              "name": "gain",
              "value": "={{ $json.body.gain || 20 }}"
            },
            {
              "name": "language",
              "value": "={{ $json.body.language || '' }}"
            },
            {
              "name": "mode",
              "value": "={{ $json.body.mode || 'voice' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-parameters",
      "name": "Extract Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:5000/capture-and-transcribe",
        "authentication": "none",
        "requestMethod": "POST",
        "bodyParametersJson": "={{ JSON.stringify({\n  frequency: $json.frequency,\n  modulation: $json.modulation,\n  duration: $json.duration,\n  gain: $json.gain,\n  language: $json.language,\n  mode: $json.mode\n}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "capture-and-transcribe",
      "name": "Capture & Transcribe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "success"
            }
          ]
        }
      },
      "id": "check-success",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "text",
              "value": "={{ $json.transcription.text }}"
            },
            {
              "name": "language",
              "value": "={{ $json.transcription.language }}"
            },
            {
              "name": "duration",
              "value": "={{ $json.transcription.duration }}"
            },
            {
              "name": "audio_file",
              "value": "={{ $json.capture.audio_file }}"
            },
            {
              "name": "frequency",
              "value": "={{ $json.capture.frequency }}"
            },
            {
              "name": "modulation",
              "value": "={{ $json.capture.modulation }}"
            }
          ]
        }
      },
      "id": "format-success-response",
      "name": "Format Success Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error",
              "value": "={{ $json.error || 'Unknown error occurred' }}"
            }
          ]
        }
      },
      "id": "format-error-response",
      "name": "Format Error Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "responseCode": 500,
        "options": {}
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
