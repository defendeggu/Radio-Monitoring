          },
          "format": "table",
          "rawSql": "SELECT \n  id,\n  created_at,\n  ROUND(frequency::numeric / 1000000, 3) as frequency_mhz,\n  modulation,\n  duration,\n  transcription_text,\n  language,\n  ROUND(language_confidence::numeric, 2) as lang_conf,\n  status\nFROM captures\nWHERE \n  ('$Modulation' = 'All' OR modulation = '$Modulation')\n  AND ('$Language' = 'All' OR language = '$Language')\n  AND (\n    '$SearchText' = '' \n    OR transcription_text ILIKE '%$SearchText%'\n  )\nORDER BY created_at DESC\nLIMIT 100;",
          "refId": "A"
        }
      ],
      "title": "Radio Captures Browser",
      "type": "table"
    }
