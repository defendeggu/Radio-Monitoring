            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  r.callsign,\n  r.output_frequency / 1000000.0 AS frequency_mhz,\n  r.band,\n  r.location_name,\n  r.canton,\n  AVG(ra.activity_percentage) AS avg_activity_pct,\n  SUM(ra.transmission_count) AS total_transmissions,\n  COUNT(ra.id) AS scan_count,\n  MAX(ra.created_at) AS last_scan\nFROM repeaters r\nLEFT JOIN repeater_activity ra ON r.id = ra.repeater_id\nWHERE ra.created_at > NOW() - INTERVAL '24 hours'\nGROUP BY r.id\nORDER BY avg_activity_pct DESC NULLS LAST\nLIMIT 20;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [],
            "limit": 50
          }
        }
      ],
      "title": "Most Active Repeaters (24h)",
      "type": "table"
