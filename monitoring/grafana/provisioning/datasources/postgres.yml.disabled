apiVersion: 1

datasources:
  - name: Radio PostgreSQL
    type: grafana-postgresql-datasource
    access: proxy
    url: radio-postgres:5432
    database: radio_monitoring
    user: radio_user
    secureJsonData:
      password: 'radio_password_change_in_production'
    jsonData:
      sslmode: 'disable'
      maxOpenConns: 100
      maxIdleConns: 100
      connMaxLifetime: 14400
      postgresVersion: 1600
      timescaledb: false
    editable: true
    uid: radio-postgres-db
