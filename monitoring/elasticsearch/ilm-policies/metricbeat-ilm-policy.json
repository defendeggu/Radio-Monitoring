{
  "policy": {
    "_meta": {
      "description": "Metricbeat data stream metricbeat-radiomoni: a new backing index every day, deleted after 7 days"
    },
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": {
            "max_age": "1d",
            "max_primary_shard_size": "10gb"
          }
        }
      },
      "delete": {
        "min_age": "7d",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}
