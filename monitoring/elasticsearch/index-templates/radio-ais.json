{
  "index_patterns": [
    "radio-ais-*"
  ],
  "priority": 200,
  "version": 4,
  "_meta": {
    "managed_by": "radiomoni",
    "description": "RadioMoni radio-ais daily indices"
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "radio-retention-policy",
      "refresh_interval": "5s"
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "uuid": {
          "type": "keyword"
        },
        "session_id": {
          "type": "keyword"
        },
        "capture_id": {
          "type": "keyword"
        },
        "frequency": {
          "type": "long"
        },
        "frequency_mhz": {
          "type": "float"
        },
        "mmsi": {
          "type": "keyword"
        },
        "msg_type": {
          "type": "integer"
        },
        "shipname": {
          "type": "keyword"
        },
        "callsign": {
          "type": "keyword"
        },
        "ship_type": {
          "type": "integer"
        },
        "destination": {
          "type": "keyword"
        },
        "imo": {
          "type": "keyword"
        },
        "status": {
          "type": "integer"
        },
        "speed": {
          "type": "float"
        },
        "course": {
          "type": "float"
        },
        "heading": {
          "type": "float"
        },
        "turn": {
          "type": "float"
        },
        "latitude": {
          "type": "float"
        },
        "longitude": {
          "type": "float"
        },
        "position": {
          "type": "geo_point"
        },
        "raw": {
          "type": "keyword",
          "ignore_above": 2048
        }
      },
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ]
    }
  }
}
