{
  "index_patterns": [
    "radio-repeater-activity-*"
  ],
  "priority": 200,
  "version": 4,
  "_meta": {
    "managed_by": "radiomoni",
    "description": "RadioMoni radio-repeater-activity daily indices"
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "radio-retention-policy",
      "refresh_interval": "5s"
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "uuid": {
          "type": "keyword"
        },
        "session_id": {
          "type": "keyword"
        },
        "repeater_id": {
          "type": "keyword"
        },
        "repeater_callsign": {
          "type": "keyword"
        },
        "frequency": {
          "type": "long"
        },
        "frequency_mhz": {
          "type": "float"
        },
        "band": {
          "type": "keyword"
        },
        "canton": {
          "type": "keyword"
        },
        "location_name": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword"
            }
          }
        },
        "carrier_detected": {
          "type": "boolean"
        },
        "transmission_count": {
          "type": "integer"
        },
        "activity_percentage": {
          "type": "float"
        },
        "average_signal_strength": {
          "type": "float"
        },
        "noise_floor": {
          "type": "float"
        },
        "scan_duration_seconds": {
          "type": "integer"
        },
        "capture_id": {
          "type": "keyword"
        },
        "peak_signal_strength": {
          "type": "float"
        },
        "total_active_seconds": {
          "type": "float"
        },
        "scan_start_time": {
          "type": "date"
        },
        "scan_end_time": {
          "type": "date"
        },
        "created_at": {
          "type": "date"
        },
        "metrics": {
          "type": "object",
          "enabled": false
        }
      },
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ]
    }
  }
}
