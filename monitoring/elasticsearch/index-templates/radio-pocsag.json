{
  "index_patterns": [
    "radio-pocsag-*"
  ],
  "priority": 200,
  "version": 4,
  "_meta": {
    "managed_by": "radiomoni",
    "description": "RadioMoni radio-pocsag daily indices"
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "radio-retention-policy",
      "refresh_interval": "5s"
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "uuid": {
          "type": "keyword"
        },
        "session_id": {
          "type": "keyword"
        },
        "capture_id": {
          "type": "keyword"
        },
        "frequency": {
          "type": "long"
        },
        "frequency_mhz": {
          "type": "float"
        },
        "address": {
          "type": "long"
        },
        "message_type": {
          "type": "keyword"
        },
        "function_code": {
          "type": "integer"
        },
        "baud_rate": {
          "type": "integer"
        },
        "message_text": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "raw_packet": {
          "type": "keyword",
          "ignore_above": 2048
        },
        "raw_line": {
          "type": "keyword",
          "ignore_above": 2048
        },
        "channel_label": {
          "type": "keyword"
        }
      },
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ]
    }
  }
}
