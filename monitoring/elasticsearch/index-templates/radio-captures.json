{
  "index_patterns": [
    "radio-captures-*"
  ],
  "priority": 200,
  "version": 4,
  "_meta": {
    "managed_by": "radiomoni",
    "description": "RadioMoni radio-captures daily indices"
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "radio-retention-policy",
      "refresh_interval": "5s",
      "analysis": {
        "analyzer": {
          "multilingual_analyzer": {
            "type": "standard",
            "stopwords": "_none_"
          }
        }
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "uuid": {
          "type": "keyword"
        },
        "frequency": {
          "type": "long"
        },
        "frequency_mhz": {
          "type": "float"
        },
        "duration_seconds": {
          "type": "integer"
        },
        "modulation": {
          "type": "keyword"
        },
        "sample_rate": {
          "type": "integer"
        },
        "rf_gain": {
          "type": "integer"
        },
        "sdr_type": {
          "type": "keyword"
        },
        "transcription": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            },
            "english": {
              "type": "text",
              "analyzer": "english"
            },
            "german": {
              "type": "text",
              "analyzer": "german"
            },
            "french": {
              "type": "text",
              "analyzer": "french"
            },
            "spanish": {
              "type": "text",
              "analyzer": "spanish"
            }
          },
          "analyzer": "multilingual_analyzer"
        },
        "detected_language": {
          "type": "keyword"
        },
        "confidence_score": {
          "type": "float"
        },
        "audio_file": {
          "type": "keyword"
        },
        "audio_url": {
          "type": "keyword",
          "index": false
        },
        "status": {
          "type": "keyword"
        },
        "segments": {
          "type": "nested",
          "properties": {
            "start": {
              "type": "float"
            },
            "end": {
              "type": "float"
            },
            "text": {
              "type": "text"
            }
          }
        },
        "metadata": {
          "type": "object",
          "enabled": false
        },
        "mode": {
          "type": "keyword"
        },
        "json_file": {
          "type": "keyword"
        },
        "file_size": {
          "type": "long"
        },
        "transcription_duration": {
          "type": "float"
        },
        "peak_power_db": {
          "type": "float"
        },
        "noise_floor_db": {
          "type": "float"
        },
        "created_at": {
          "type": "date"
        },
        "session_id": {
          "type": "keyword"
        }
      },
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ]
    }
  }
}
