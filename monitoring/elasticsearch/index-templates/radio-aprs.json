{
  "index_patterns": [
    "radio-aprs-*"
  ],
  "priority": 200,
  "version": 4,
  "_meta": {
    "managed_by": "radiomoni",
    "description": "RadioMoni radio-aprs daily indices"
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "radio-retention-policy",
      "refresh_interval": "5s"
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "uuid": {
          "type": "keyword"
        },
        "session_id": {
          "type": "keyword"
        },
        "capture_id": {
          "type": "keyword"
        },
        "frequency": {
          "type": "long"
        },
        "frequency_mhz": {
          "type": "float"
        },
        "source_callsign": {
          "type": "keyword"
        },
        "destination_callsign": {
          "type": "keyword"
        },
        "path": {
          "type": "keyword"
        },
        "packet_type": {
          "type": "keyword"
        },
        "aprs_type": {
          "type": "keyword"
        },
        "symbol_table": {
          "type": "keyword"
        },
        "symbol_code": {
          "type": "keyword"
        },
        "position": {
          "type": "geo_point"
        },
        "latitude": {
          "type": "float"
        },
        "longitude": {
          "type": "float"
        },
        "altitude": {
          "type": "float"
        },
        "speed": {
          "type": "float"
        },
        "course": {
          "type": "float"
        },
        "message_text": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "raw_packet": {
          "type": "keyword",
          "ignore_above": 2048
        },
        "channel_label": {
          "type": "keyword"
        },
        "aprs_data": {
          "type": "object",
          "enabled": false
        },
        "maidenhead": {
          "type": "keyword"
        }
      },
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ]
    }
  }
}
