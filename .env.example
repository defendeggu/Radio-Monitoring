# =============================================================================
# RadioMoni — configuration template
#
# Do not copy this file by hand: run  ./scripts/setup-env.sh
# It creates .env with random secrets (chmod 600). This file only documents
# the available variables. Never commit .env.
# =============================================================================

# --- Deployment ---------------------------------------------------------------
# "elk" = full stack (Elasticsearch, Logstash, Kibana, Beats). Empty = light profile.
COMPOSE_PROFILES=elk
# elasticsearch | sqlite (light profile)
STORAGE_BACKEND=elasticsearch
# Web UI port on the host and bind address (0.0.0.0 = all interfaces)
WEB_PORT=8080
WEB_BIND=0.0.0.0
# Kibana is only reachable from this host by default
KIBANA_BIND=127.0.0.1
KIBANA_PORT=5601
TZ=Europe/Zurich
# Elastic stack version and Elasticsearch heap
ELK_VERSION=9.5.5
ES_HEAP=2g
# 1 = include UHD/GNU Radio for the Ettus USRP N200 in the API image (~1 GB larger)
WITH_USRP=0

# --- API security ---------------------------------------------------------------
# Comma-separated keys (32+ characters). Required — the API does not start without.
API_KEYS=
# Networks that may use the API without a key (CIDR, comma-separated). Default: none.
# Example for a home LAN: 192.168.1.0/24
TRUSTED_IPS=
# Read-only key for /metrics/* (Metricbeat reads the GPU usage with it, GPU setup only).
# Generated by setup-env.sh.
METRICS_API_KEY=
# Only for local development outside Docker: run without API keys
# ALLOW_INSECURE=true

# --- Secrets (generated by setup-env.sh) ----------------------------------------
REDIS_PASSWORD=
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
LOGSTASH_SYSTEM_PASSWORD=
LOGSTASH_WRITER_PASSWORD=
LOGSTASH_HTTP_PASSWORD=
BEATS_SYSTEM_PASSWORD=
BEATS_WRITER_PASSWORD=
RADIO_API_PASSWORD=
KIBANA_ENCRYPTION_KEY=

# --- Whisper transcription ------------------------------------------------------
# tiny | base | small | medium | large-v3 | large-v3-turbo | distil-large-v3
WHISPER_MODEL=small
# cpu | cuda (see docker-compose.gpu.yml)
WHISPER_DEVICE=cpu
# int8 (CPU) | float16 (GPU)
WHISPER_COMPUTE_TYPE=int8
# Vocabulary hint, e.g. callsigns and place names
WHISPER_INITIAL_PROMPT=

# --- Recordings -------------------------------------------------------------------
# Delete recordings older than N days (0 = keep forever)
RECORDING_RETENTION_DAYS=30
# Refuse new recordings below this much free disk space
MIN_FREE_DISK_MB=500
# Secret for signed links to WAV files (play button in Kibana). Generated by setup-env.sh.
# Empty = no links. Changing it invalidates all existing links.
RECORDING_LINK_SECRET=
# URL under which the browser reaches the web UI; used for the audio links in Kibana
# (default http://localhost:${WEB_PORT})
# WEB_PUBLIC_URL=http://radiomoni.lan:8080

# --- Alert notifications (optional) ---------------------------------------------
# ntfy: full topic URL, optional access token
NTFY_URL=
NTFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic webhook (JSON POST)
ALERT_WEBHOOK_URL=
# E-mail via SMTP (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# --- Logging -------------------------------------------------------------------------
LOG_LEVEL=INFO
