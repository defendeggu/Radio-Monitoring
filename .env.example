# ============================================================================
# Radio Monitoring System - Environment Configuration Template
# ============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Generate API keys: python3 scripts/generate_api_keys.py
# 4. Generate ELK credentials: ./setup-elk-security.sh (if using ELK stack)
# 5. Keep .env secure - NEVER commit to Git!
#
# ============================================================================

# ============================================================================
# HackRF / RTL-SDR Radio Configuration
# ============================================================================

# Default frequency to tune to (in Hz)
# Examples: 88.5 MHz FM Radio = 88500000, 144.8 MHz APRS = 144800000
DEFAULT_FREQUENCY=100000000

# Sample rate for SDR capture (samples per second)
# HackRF: 2-20 MHz, RTL-SDR: 0.225-3.2 MHz
DEFAULT_SAMPLE_RATE=2000000

# Default modulation type
# Options: FM, AM, WFM (Wide FM), NFM (Narrow FM)
DEFAULT_MODULATION=FM

# RF Gain in dB (0-40 for HackRF, 0-50 for RTL-SDR)
# Higher = stronger signal but more noise
DEFAULT_GAIN=20

# ============================================================================
# Whisper Transcription Configuration
# ============================================================================

# Whisper model size
# Options: tiny, base, small, medium, large
# Larger = better quality but slower and more memory
# Recommended: base (good balance), tiny (fast but less accurate)
WHISPER_MODEL=base

# Device for Whisper inference
# Options: cpu, cuda (GPU), auto
# Use 'cuda' if you have NVIDIA GPU with CUDA installed
WHISPER_DEVICE=cpu

# Compute type for faster-whisper
# Options: int8, int16, float16, float32
# int8 = fastest, lowest memory, slight quality loss
WHISPER_COMPUTE_TYPE=int8

# ============================================================================
# Recording Configuration
# ============================================================================

# Default recording duration in seconds
RECORDING_DURATION=30

# Directory for audio output files
# Relative to project root or absolute path
AUDIO_OUTPUT_DIR=./recordings

# ============================================================================
# API Security (REQUIRED for Production)
# ============================================================================

# API Keys for authentication (comma-separated list)
# Generate with: python3 scripts/generate_api_keys.py
#
# Example: API_KEYS=key1-here,key2-here,key3-here
#
# ⚠️  SECURITY: Keep these secret! Required for all API requests (except /health)
# Each key should be 32+ characters, cryptographically random
#
# Leave empty for development (disables authentication):
API_KEYS=

# ============================================================================
# Elasticsearch Configuration
# ============================================================================

# Elasticsearch cluster hosts (comma-separated)
# Docker internal: http://elasticsearch:9200
# External access: http://localhost:9200
ELASTICSEARCH_HOSTS=http://elasticsearch:9200

# Elasticsearch connection URL with authentication
# Format: http://username:password@host:port
# The ${ELASTIC_PASSWORD} will be substituted from password below
ELASTICSEARCH_URL=http://elastic:${ELASTIC_PASSWORD}@elasticsearch:9200

# External Elasticsearch URL (for host machine access)
ELASTICSEARCH_URL_EXTERNAL=http://elastic:${ELASTIC_PASSWORD}@localhost:9200

# Index prefix for all radio data
# Creates indices like: radio-captures-YYYY.MM.DD, radio-aprs-YYYY.MM.DD
INDEX_PREFIX=radio

# ============================================================================
# ELK Stack Security Credentials
# ============================================================================
#
# ⚠️  SECURITY WARNING:
# - Generate these with: ./setup-elk-security.sh
# - These are sensitive credentials - do NOT commit to Git!
# - For production: Use Docker Secrets instead of environment variables
# - Keep .env file permissions restricted: chmod 600 .env
#
# ============================================================================

# Elasticsearch built-in user passwords
# Generate strong passwords with: openssl rand -base64 24
ELASTIC_PASSWORD=changeme
KIBANA_SYSTEM_PASSWORD=changeme
LOGSTASH_SYSTEM_PASSWORD=changeme
BEATS_SYSTEM_PASSWORD=changeme

# ============================================================================
# Logstash Pipeline Configuration
# ============================================================================

# Logstash HTTP input endpoints (internal Docker network)
LOGSTASH_HOST=http://logstash:9600
LOGSTASH_APRS_HOST=http://logstash:9601
LOGSTASH_POCSAG_HOST=http://logstash:9602
LOGSTASH_REPEATER_HOST=http://logstash:9603
LOGSTASH_METRICS_HOST=http://logstash:9604

# ============================================================================
# Redis Configuration (for Streaming Sessions)
# ============================================================================

# Redis host (Docker service name or IP)
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379

# Redis database number (0-15)
REDIS_DB=0

# Redis password (optional, leave empty if no auth)
REDIS_PASSWORD=

# ============================================================================
# Streaming Decoder Configuration
# ============================================================================

# Session timeout in seconds (how long to keep inactive sessions)
# Default: 300 seconds (5 minutes)
STREAM_SESSION_TIMEOUT=300

# Maximum concurrent streaming sessions
# Limit to prevent resource exhaustion
MAX_STREAMING_SESSIONS=10

# ============================================================================
# Repeater Scanner Configuration
# ============================================================================

# Maximum concurrent repeater scans
# Each scan can take 10-30 minutes, limit prevents overload
MAX_REPEATER_SCANS=5

# Session cleanup interval (hours)
# Old scan sessions are automatically removed after this time
REPEATER_SESSION_MAX_AGE_HOURS=24

# ============================================================================
# N8N Workflow Automation Configuration
# ============================================================================

# N8N webhook URL for radio transcription events
# Format: http://n8n-host:5678/webhook/your-webhook-name
N8N_WEBHOOK_URL=http://localhost:5678/webhook/radio-transcription

# N8N web UI URL (for workflow management)
N8N_HOST=http://n8n:5679

# ============================================================================
# Kibana Configuration
# ============================================================================

# Kibana URL for dashboard access
KIBANA_URL=http://localhost:5601

# ============================================================================
# Flask / Gunicorn Configuration (Optional - Production)
# ============================================================================

# Flask debug mode (NEVER enable in production!)
# Options: true, false
FLASK_DEBUG=false

# Gunicorn worker processes (CPU cores × 2 + 1 recommended)
GUNICORN_WORKERS=4

# Gunicorn log level
# Options: debug, info, warning, error, critical
GUNICORN_LOG_LEVEL=info

# API port (only used in some deployment scenarios)
API_PORT=5000

# ============================================================================
# Database Configuration (if using PostgreSQL - currently unused)
# ============================================================================
# These variables are detected in code but not currently used
# Reserved for future PostgreSQL integration

# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=radio_monitoring
# POSTGRES_USER=radiouser
# POSTGRES_PASSWORD=changeme

# ============================================================================
# NOTES
# ============================================================================
#
# Quick Start:
#   1. Copy this file: cp .env.example .env
#   2. Generate API keys: python3 scripts/generate_api_keys.py
#   3. Generate ELK passwords: ./setup-elk-security.sh
#   4. Update .env with generated values
#   5. Start system: docker compose up -d
#
# Docker vs Manual Setup:
#   - Docker: Uses service names (elasticsearch, redis, logstash)
#   - Manual: Uses localhost URLs (http://localhost:9200, etc.)
#
# Security Best Practices:
#   - Always set strong API_KEYS in production
#   - Use ./setup-elk-security.sh for ELK passwords
#   - Never commit .env to Git (already in .gitignore)
#   - Set file permissions: chmod 600 .env
#   - Rotate API keys and passwords regularly
#   - Use Docker Secrets for production deployments
#
# For detailed documentation see:
#   - README.md - Complete system documentation
#   - USER_MANUAL.md - User guide (German)
#   - QUICKSTART.md - Fast setup guide
#
# ============================================================================
